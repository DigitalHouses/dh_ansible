[Unit]
Description=DigitalHouses site-inventory trusted root-only provider
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/semaphore/dh-site-data.request

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/dh-site-data-runner
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/semaphore /run
