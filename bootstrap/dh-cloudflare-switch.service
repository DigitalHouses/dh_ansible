[Unit]
Description=DigitalHouses one-shot Cloudflare connector cutover
ConditionPathExists=/var/lib/semaphore/dh-cloudflare-switch.request
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/dh-cloudflare-runner-cutover
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
