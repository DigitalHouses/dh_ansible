[Unit]
Description=DigitalHouses Filestash
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=filestash
Group=filestash
WorkingDirectory=/opt/dh-filestash
EnvironmentFile=/etc/digitalhouses/filestash.env
ExecStart=/opt/dh-filestash/filestash
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
