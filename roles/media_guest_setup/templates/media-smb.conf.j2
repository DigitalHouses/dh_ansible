# DigitalHouses — authenticated shared storage; no guest permissions.
[global]
    workgroup = {{ media_vm.discovery.workgroup }}
    netbios name = {{ media_vm.discovery.netbios_name }}
    server role = standalone server
    map to guest = Never
    server min protocol = SMB2
    load printers = no
    disable spoolss = yes

[Media]
    comment = Media library
    path = /{{ media_vm.storage.media_dataset }}
    browseable = yes
    read only = no
    guest ok = no
    valid users = {{ media_vm.file_access.accounts | selectattr('role', 'equalto', 'owner') | map(attribute='name') | first }} serzhan_admin
    force group = media_group
    create mask = 0660
    directory mask = 2770
    force directory mode = 2000

[Documents]
    comment = Documents
    path = /{{ media_vm.storage.pool_name }}/doc
    browseable = yes
    read only = no
    guest ok = no
    valid users = {{ media_vm.file_access.accounts | selectattr('role', 'equalto', 'owner') | map(attribute='name') | first }} serzhan_admin
    force group = doc_group
    create mask = 0660
    directory mask = 2770
    force directory mode = 2000

[DigitalHouses]
    comment = DigitalHouses administrator data
    path = /{{ media_vm.storage.pool_name }}/digitalhouses
    browseable = yes
    read only = no
    guest ok = no
    valid users = serzhan_admin
    force group = admin_group
    create mask = 0660
    directory mask = 2770
    force directory mode = 2000

[Backups]
    comment = Backup administration
    path = /{{ media_vm.storage.pool_name }}/backups
    browseable = yes
    read only = no
    guest ok = no
    valid users = serzhan_admin
    force group = backup_group
    create mask = 0660
    directory mask = 2770
    force directory mode = 2000
