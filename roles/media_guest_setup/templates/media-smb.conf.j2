# DigitalHouses: authenticated SMB over POSIX media_group (no anonymous access).
[global]
    workgroup = {{ media_vm.discovery.workgroup }}
    netbios name = {{ media_vm.discovery.netbios_name }}
    server role = standalone server
    map to guest = Never
    server min protocol = SMB2
    load printers = no
    disable spoolss = yes

[Media]
    comment = Media library (movies / tvshows / music)
    path = /{{ media_vm.storage.media_dataset }}
    browseable = yes
    read only = yes
    guest ok = no
    valid users = @dh_media_readers @dh_media_writers
    write list = @dh_media_writers
    force group = media_group
    create mask = 0664
    directory mask = 2775
    force directory mode = 2000
