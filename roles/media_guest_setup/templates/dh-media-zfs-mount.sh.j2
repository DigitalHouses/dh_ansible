#!/usr/bin/env bash
# Re-import ONLY the known ZFS pool on the sole verified SATA disk after boot.
# Boot always uses the read-only import operation (never disk provisioning).
set -Eeuo pipefail

/usr/local/sbin/dh-media-storage \
  --config /etc/digitalhouses/media-storage.json \
  --action import \
  --owner {{ media_owner_slug | quote }}

test -d {{ ('/' ~ media_vm.storage.media_dataset) | quote }}
echo "MEDIA_ZFS=READY"
