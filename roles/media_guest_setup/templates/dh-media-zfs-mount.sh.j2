#!/usr/bin/env bash
# Read-only import of pre-existing site media pool; never creates or modifies ZFS datasets.
set -Eeuo pipefail

POOL={{ media_vm.storage.pool_name | quote }}
GUID={{ media_vm.storage.pool_guid | quote }}
PART="/dev/disk/by-partuuid/{{ media_vm.storage.partition_partuuid }}"

for attempt in $(seq 1 30); do
  if test -b "$PART"; then break; fi
  sleep 1
done
test -b "$PART" || { echo "MEDIA_ZFS=PARTITION_MISSING"; exit 2; }

/usr/sbin/modprobe zfs
if ! /usr/sbin/zpool list -H -o name "$POOL" >/dev/null 2>&1; then
  /usr/sbin/zpool import -N -f -o readonly=on "$POOL"
fi
test "$(/usr/sbin/zpool get -H -o value readonly "$POOL")" = "on" ||
  { echo "MEDIA_ZFS=WRITABLE_IMPORT_NOT_ALLOWED"; exit 2; }
test "$(/usr/sbin/zpool get -H -o value guid "$POOL")" = "$GUID" ||
  { echo "MEDIA_ZFS=GUID_MISMATCH"; exit 2; }
test "$(/usr/sbin/zpool list -H -o health "$POOL")" = "ONLINE" ||
  { echo "MEDIA_ZFS=POOL_NOT_ONLINE"; exit 2; }

{% set parts = media_vm.storage.media_dataset.split('/') %}
{% for level in range(1, parts | length + 1) %}
DATASET={{ (parts[:level] | join('/')) | quote }}
/usr/sbin/zfs list -H -o name "$DATASET" >/dev/null
if test "$(/usr/sbin/zfs get -H -o value mounted "$DATASET")" != "yes"; then
  /usr/sbin/zfs mount "$DATASET"
fi
{% endfor %}
test -d {{ ('/' ~ media_vm.storage.media_dataset) | quote }} ||
  { echo "MEDIA_ZFS=MEDIA_NOT_MOUNTED"; exit 2; }
echo "MEDIA_ZFS=READY_READONLY"
