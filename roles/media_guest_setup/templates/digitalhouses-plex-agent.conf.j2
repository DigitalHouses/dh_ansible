[general]
instance_id = plex
instance_name = {{ media_vm.name }}
poll_interval_seconds = 10
cpu_window_seconds = 60
log_level = info

[telemetry]
enabled = false
cpu_change_threshold = 5
high_load_threshold = 80
high_load_publish_interval_seconds = 60

[plex_api]
enabled = true
base_url = http://127.0.0.1:32400
token_file = /etc/digitalhouses_plex_agent/plex_local_admin_token
timeout_seconds = 3
library_refresh_seconds = 3600

[mqtt]
host = {{ media_vm.plex_agent.mqtt.host }}
port = {{ media_vm.plex_agent.mqtt.port }}
username = {{ media_vm.plex_agent.mqtt.username }}
password = {{ media_vm.plex_agent.mqtt.password }}
topic_prefix = DigitalHouses/Global/digitalhouses_plex_agent
discovery_prefix = homeassistant
keepalive_seconds = 60
