server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ media_vm.network.ipv4.split('/')[0] }};
    root /var/www/dh-media-portal;
    index index.html;
    autoindex off;
    ssl_certificate /etc/digitalhouses/media-account-pki/server.crt;
    ssl_certificate_key /etc/digitalhouses/media-account-pki/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location ^~ /account/api/ {
        allow 192.168.11.0/24;
        deny all;
        access_log off;
        client_max_body_size 512;
        client_body_timeout 10s;
        proxy_read_timeout 180s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_pass http://unix:/run/dh-media-account/service.sock:;
    }

    location ^~ /account/ {
        allow 192.168.11.0/24;
        deny all;
        add_header Cache-Control "no-store" always;
        try_files $uri $uri/ =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
